<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Poha Shack — Pricing Analysis</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Serif+Display&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --bg: #FAFAF8; --surface: #fff; --border: #E8E5DE;
    --text: #1A1A18; --text2: #5C5A52; --text3: #8E8B82;
    --accent: #2D6A4F; --accent-light: #E8F3ED; --accent-dark: #1B4332;
    --orange: #D4740E; --orange-light: #FFF3E6;
    --red: #C53030; --red-light: #FFF0F0;
    --blue: #2563EB; --blue-light: #EFF6FF;
    --chart1: #2D6A4F; --chart2: #D4740E; --chart3: #2563EB;
    --chart4: #8B5CF6; --chart5: #059669; --chart6: #DC2626;
    --chart7: #0891B2; --chart8: #CA8A04;
  }
  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }

  .container { max-width: 1100px; margin: 0 auto; padding: 32px 24px 60px; }

  header { margin-bottom: 40px; border-bottom: 2px solid var(--text); padding-bottom: 20px; }
  header h1 { font-family: 'DM Serif Display', serif; font-size: 32px; font-weight: 400; letter-spacing: -0.5px; }
  header .sub { color: var(--text2); font-size: 14px; margin-top: 4px; }

  .section { margin-bottom: 44px; }
  .section-title { font-size: 18px; font-weight: 700; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }

  /* KPI cards */
  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 32px; }
  .kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
  .kpi .value { font-size: 26px; font-weight: 700; color: var(--accent-dark); }
  .kpi .label { font-size: 12px; color: var(--text2); margin-top: 2px; }
  .kpi.highlight { border-color: var(--orange); background: var(--orange-light); }
  .kpi.highlight .value { color: var(--orange); }

  /* Charts */
  .chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  @media (max-width: 700px) { .chart-row { grid-template-columns: 1fr; } }
  .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
  .chart-card h3 { font-size: 14px; font-weight: 600; margin-bottom: 12px; color: var(--text2); }
  canvas { width: 100% !important; }

  /* Tables */
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; font-weight: 600; color: var(--text2); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; padding: 8px 10px; border-bottom: 2px solid var(--border); }
  td { padding: 7px 10px; border-bottom: 1px solid var(--border); }
  tr:hover td { background: #f9f9f6; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 10px; }
  .badge-green { background: var(--accent-light); color: var(--accent); }
  .badge-orange { background: var(--orange-light); color: var(--orange); }
  .badge-red { background: var(--red-light); color: var(--red); }

  /* Recommendation boxes */
  .rec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 700px) { .rec-grid { grid-template-columns: 1fr; } }
  .rec { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; border-left: 4px solid var(--accent); }
  .rec.warn { border-left-color: var(--orange); }
  .rec.critical { border-left-color: var(--red); }
  .rec h4 { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
  .rec p { font-size: 13px; color: var(--text2); line-height: 1.6; }
  .rec .price-tag { font-size: 15px; font-weight: 700; color: var(--accent-dark); margin-top: 8px; }

  .insight-box { background: var(--blue-light); border: 1px solid #BFDBFE; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
  .insight-box h4 { font-size: 14px; font-weight: 700; color: var(--blue); margin-bottom: 6px; }
  .insight-box p { font-size: 13px; color: var(--text); line-height: 1.7; }

  .verdict { background: var(--accent-light); border: 2px solid var(--accent); border-radius: 10px; padding: 24px; margin-top: 20px; }
  .verdict h3 { font-family: 'DM Serif Display', serif; font-size: 22px; margin-bottom: 10px; color: var(--accent-dark); }
  .verdict p { font-size: 14px; line-height: 1.7; color: var(--text); }
  .verdict .highlight-num { font-size: 20px; font-weight: 700; color: var(--accent-dark); }

  .footnote { font-size: 12px; color: var(--text3); margin-top: 40px; border-top: 1px solid var(--border); padding-top: 16px; }

  .tab-bar { display: flex; gap: 0; border-bottom: 2px solid var(--border); margin-bottom: 20px; overflow-x: auto; }
  .tab-bar button { background: none; border: none; padding: 10px 18px; font-size: 13px; font-weight: 600; color: var(--text3); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; white-space: nowrap; }
  .tab-bar button.active { color: var(--accent-dark); border-bottom-color: var(--accent); }
  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .bar-h { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .bar-h .bar-label { font-size: 12px; width: 90px; text-align: right; flex-shrink: 0; color: var(--text2); }
  .bar-h .bar-track { flex: 1; height: 20px; background: #f0ede6; border-radius: 4px; overflow: hidden; }
  .bar-h .bar-fill { height: 100%; border-radius: 4px; transition: width 0.4s; }
  .bar-h .bar-val { font-size: 12px; font-weight: 600; width: 60px; flex-shrink: 0; }

  .qual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 700px) { .qual-grid { grid-template-columns: 1fr; } }
  .qual-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
  .qual-card h4 { font-size: 13px; font-weight: 700; margin-bottom: 6px; }
  .qual-card p { font-size: 12px; color: var(--text2); line-height: 1.6; }
  .qual-card .metric { font-size: 11px; font-weight: 600; color: var(--accent); margin-top: 6px; }
</style>
</head>
